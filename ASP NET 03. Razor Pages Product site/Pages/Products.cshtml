@page
@model ASP_NET_03._Razor_Pages_Product_site.Pages.ProductsModel

<div class="container mt-4">
    @if (Model.Products.Any())
    {
        <h3 class="mb-4">Products</h3>

        <div class="row g-4">
            @foreach (var product in Model.Products)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">                                
                                    @product.Name                                
                            </h5>

                            <p class="card-text text-muted small mt-auto">
                                In stock
                            </p>

                           @*  <a href="/product?id=@product.Id" class="btn btn-outline-primary btn-sm mt-2">
                                View details
                            </a> *@

                            <a 
                                class="btn btn-outline-primary btn-sm mt-2" 
                                asp-page="product" 
                                asp-route-id="@product.Id">
                                View details
                            </a>

                            @* <a href="/product/@product.Id" class="btn btn-outline-primary btn-sm mt-2">
                                View details
                            </a> *@

                           
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No products available.
        </div>
    }
</div>
