@model User
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <form method="get" asp-action="Welcome">
        <p>
            <input asp-for="Name" />
        </p>
        <p>
            <input asp-for="Password" type="password" />
        </p>
        <p>
            <input type="submit" value="Log in"/>
        </p>
    </form>
</div>
